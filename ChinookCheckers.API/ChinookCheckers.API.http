@ChinookCheckers.API_HostAddress = http://localhost:5157

GET {{ChinookCheckers.API_HostAddress}}/healthz
Accept: application/json

###

POST {{ChinookCheckers.API_HostAddress}}/v1/move/suggest
Content-Type: application/json

{
  "gameId": "checkers-8x8",
  "state": { "notation": "PDN", "position": "B:W18,19,22,25,27,28,30,32:B1,5,6,7,10,12,14,16" },
  "level": "weak",
  "limits": { "maxDepth": 12, "softTimeMs": 250, "hardTimeMs": 1200 }
}

###

# Tablebase position (<= 8 pieces)
POST {{ChinookCheckers.API_HostAddress}}/v1/move/suggest
Content-Type: application/json

{
  "gameId": "checkers-8x8",
  "state": { "notation": "PDN", "position": "W:WK18,23,27:BK3,10,12" },
  "level": "strong"
}

###

# Invalid PDN -> 422
POST {{ChinookCheckers.API_HostAddress}}/v1/move/suggest
Content-Type: application/json

{
  "gameId": "checkers-8x8",
  "state": { "notation": "PDN", "position": "B:W33:B1" },
  "level": "medium"
}

###

# Legal moves + resulting positions (used by the web UI)
POST {{ChinookCheckers.API_HostAddress}}/v1/move/legal
Content-Type: application/json

{
  "position": "B:W21-32:B1-12"
}

###

POST {{ChinookCheckers.API_HostAddress}}/v1/move/validate
Content-Type: application/json

{
  "position": "B:W18,19,22,25,27,28,30,32:B1,5,6,7,10,12,14,16",
  "move": "14x23"
}
