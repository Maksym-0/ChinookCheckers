{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Engine": {
    "Type": "kingsrow_dll",
    "Name": "chinook",
    "Path": "Engine\\app\\Kingsrow64.dll",
    "Workers": 2,
    "Databases": "D:\\Projects\\ChinookCheckers\\ChinookCheckers.Infrastructure\\Engine\\db",
    "TablebaseMaxPieces": 8,
    "HashSizeMb": 64,
    "DbCacheMb": 512,
    "SearchThreadsPerWorker": 1,
    "WarmupTimeMs": 100,
    "UseExactTime": true
  },
  "Cache": {
    "Capacity": 20000,
    "TtlMinutes": 15
  },
  "Limits": {
    "DefaultSoftTimeMs": 300,
    "DefaultHardTimeMs": 1200,
    "MaxHardTimeMs": 10000,
    "HardTimeSafetyMarginMs": 100,
    "TablebaseTimeMs": 30,
    "Weak": { "TimeMs": 100, "Depth": 8 },
    "Medium": { "TimeMs": 250, "Depth": 12 },
    "Strong": { "TimeMs": 500, "Depth": 18 }
  }
}
